# Copiar para .env nesta pasta (não commitado) ou exportar no shell.
# Password com caracteres especiais: URL-encode (* → %2A, $ → %24, @ → %40).

# Origem (Supabase). Preferir ligação directa db.<ref>.supabase.co:5432 se o pooler falhar no dump.
SUPABASE_DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres?sslmode=require

# Destino local (já validado no notebook)
LOCAL_DATABASE_URL=postgresql://netquasar:<PASSWORD>@127.0.0.1:5432/netQUASAR?sslmode=disable

# Opcional: pasta de saída (default: ./out relativo a esta pasta)
# OUT_DIR=

# --- Backblaze B2 (S3-compatible) — ver também b2.env.example ---
# B2_KEY_ID=
# B2_APPLICATION_KEY=
# B2_BUCKET=
# B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
# B2_REGION=us-west-004
# B2_PREFIX=netquasar/postgres
