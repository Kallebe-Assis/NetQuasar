# Credenciais Backblaze B2 (S3-compatible). Copiar para b2.env (não commitado).
#
# No painel B2: Application Keys → Create a New Application Key
# (restringir ao bucket de backups se possível).
#
# Endpoint S3: no bucket → "S3 Endpoint" (ex.: s3.us-east-005.backblazeb2.com)
# → B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
# → B2_REGION=us-east-005

B2_KEY_ID=0000000000000000000000000
B2_APPLICATION_KEY=K000000000000000000000000000000
B2_BUCKET=NetQuasar
B2_BUCKET_ID=588b8a91feaac87a93f00612
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005
B2_PREFIX=netquasar/postgres
